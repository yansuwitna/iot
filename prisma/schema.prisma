generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  Users     User[]
  Projects        Project[]
  Devices         Device[]
  Classes         Class[]
  BrandingSetting BrandingSetting?

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  firstName      String
  lastName       String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  role           Role         @default(GENERAL_USER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  Projects       Project[]
  ClassesTaught  Class[]       @relation("TeacherClasses")
  ClassesEnrolled ClassMember[] @relation("StudentClasses")
  Submissions    Submission[]  @relation("StudentSubmissions")

  @@map("users")
}

enum Role {
  SUPER_ADMIN
  TENANT_OWNER
  ORGANIZATION_ADMIN
  TEACHER
  STUDENT
  GENERAL_USER
}

model Project {
  id             String       @id @default(uuid())
  name           String
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  ownerId        String
  owner          User         @relation(fields: [ownerId], references: [id])
  status         ProjectStatus @default(DRAFT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  Devices        Device[]
  ProjectVersions ProjectVersion[]
  Submissions    Submission[]

  @@map("projects")
}

enum ProjectStatus {
  DRAFT
  PLANNING
  BUILDING
  TESTING
  PUBLISHED
  ARCHIVED
}

model Device {
  id             String       @id @default(uuid())
  deviceName     String
  deviceType     String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id])
  deviceSecret   String       @unique @default(uuid())
  status         DeviceStatus @default(OFFLINE)
  lastSeen       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  TelemetryReadings TelemetryReading[]

  @@map("devices")
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

model TelemetryReading {
  id        String   @id @default(uuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id])
  payload   Json
  timestamp DateTime @default(now())

  @@index([deviceId, timestamp])
  @@map("telemetry_readings")
}

model ProjectTemplate {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  category    String
  description String?  @db.Text
  difficulty  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("project_templates")
}

model Board {
  id                   String   @id @default(uuid())
  name                 String
  manufacturer         String
  architecture         String
  chip                 String
  supportedFrameworks  String
  voltage              Float
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("boards")
}

model Component {
  id                   String   @id @default(uuid())
  name                 String
  category             String
  description          String?  @db.Text
  pinRequirement       String
  inputType            String
  outputType           String
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("components")
}

model ProjectVersion {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  versionName String
  code        String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("project_versions")
}

model Class {
  id             String        @id @default(uuid())
  name           String
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  teacherId      String
  teacher        User          @relation("TeacherClasses", fields: [teacherId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  Members        ClassMember[]
  Assignments    Assignment[]

  @@map("classes")
}

model ClassMember {
  id        String   @id @default(uuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  studentId String
  student   User     @relation("StudentClasses", fields: [studentId], references: [id])
  createdAt DateTime @default(now())

  @@map("class_members")
}

model Assignment {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  classId     String
  class       Class    @relation(fields: [classId], references: [id])
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Submissions Submission[]

  @@map("assignments")
}

model Submission {
  id           String       @id @default(uuid())
  assignmentId String
  assignment   Assignment   @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      User         @relation("StudentSubmissions", fields: [studentId], references: [id])
  projectId    String?      // Optional link to an IoT project they built
  project      Project?     @relation(fields: [projectId], references: [id])
  content      String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  Assessments  Assessment[]

  @@map("submissions")
}

model Assessment {
  id           String     @id @default(uuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])
  score        Float
  feedback     String?    @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("assessments")
}

model BrandingSetting {
  id              String       @id @default(uuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id])
  applicationName String       @default("IoT Project Learning Platform")
  logoUrl         String?
  faviconUrl      String?
  primaryColor    String       @default("#3b82f6")
  secondaryColor  String       @default("#1d4ed8")
  backgroundColor String       @default("#ffffff")
  timezone        String       @default("Asia/Jakarta")
  language        String       @default("id")
  contactEmail    String?
  footerText      String?
  customDomain    String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("branding_settings")
}
